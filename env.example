# Copy to .env for local development:  cp env.example .env
#
# In production these are set in the Vercel project settings instead — Vercel
# injects them at build and at run time, and no .env file is deployed.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Postgres. On Railway use the PUBLIC url (Variables tab → DATABASE_PUBLIC_URL),
# not the internal one: Vercel connects from outside Railway's private network.
DATABASE_URL="postgresql://user:password@host.proxy.rlwy.net:PORT/railway"

# Signs session cookies. Better Auth refuses to start without it, and changing
# it signs everyone out. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# The origin the app is served from, no trailing slash. Callbacks and login
# redirects are built from it, so a wrong value fails as a login that goes
# nowhere rather than as an error.
# Local: http://localhost:3000    Production: https://your-domain.com
BETTER_AUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Extra origins allowed to call the auth endpoints, comma-separated.
# BETTER_AUTH_URL is trusted automatically; this is for tunnels used to try the
# till on a phone.
# BETTER_AUTH_TRUSTED_ORIGINS="https://something.ngrok-free.app"

# The same hostnames again, for Next's dev-server and Server Action origin
# checks. Development only — leave unset in production.
# DEV_TUNNEL_ORIGINS="something.ngrok-free.app,something.trycloudflare.com"

# Postgres connections held per running instance. Defaults to 3 on Vercel
# (many short-lived instances) and 10 elsewhere. Raise only if the database is
# sized for it.
# DATABASE_POOL_MAX="3"

# Only if you use the hosted dashboard at dash.better-auth.com. Without it the
# dash() plugin's endpoints reject every request, which is the safe default.
# BETTER_AUTH_API_KEY=""
